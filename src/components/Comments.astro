---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const convexUrl = import.meta.env.PUBLIC_CONVEX_URL as string;
const siteUrl = convexUrl.replace(".convex.cloud", ".convex.site");
---

<div id="comments-section" class="mt-12 border-t border-border pt-6">
  <table class="w-full">
    <tbody>
      <tr class="flex w-full mb-4">
        <td class="flex-0 w-[9ch]">&nbsp;</td>
        <td class="flex-1 text-start">
          <h3 class="font-medium text-aadish m-0" id="comment-component">Comments</h3>
        </td>
      </tr>
    </tbody>
    <tbody id="comments-list">
      <tr class="flex mb-2">
        <td class="text-base !font-normal w-[9ch]">&nbsp;</td>
        <td class="text-base !font-normal flex-1 ml-1.5 pl-2 text-muted-foreground">loading...</td>
      </tr>
    </tbody>
  </table>
  <div class="mt-6">
    <table class="w-full">
      <tbody>
        <tr class="flex">
          <td class="flex-0 w-[9ch]">&nbsp;</td>
          <td class="flex-1 flex gap-3 pr-3 pb-3">
            <input
              id="comment-input"
              type="text"
              placeholder="write a comment..."
              maxlength="200"
              class="flex-1 bg-transparent border border-border px-3 py-2 text-base placeholder:text-muted-foreground focus:outline-hidden focus:border-aadish transition-colors"
            />
            <button
              id="comment-submit"
              type="button"
              disabled
              class="px-4 py-2 text-base font-medium bg-transparent border border-border hover:border-aadish hover:text-aadish disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
            >
              submit
            </button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <div id="captcha-overlay" class="fixed inset-0 bg-black/50 items-center justify-center z-50 hidden">
    <div id="captcha-container"></div>
  </div>
</div>

<script src="https://js.hcaptcha.com/1/api.js" async defer is:inline></script>
<script is:inline define:vars={{ slug, siteUrl }}>
(function() {
  const API = siteUrl + "/comments";
  const SITEKEY = "8f643442-c6fa-4714-9888-52d4a11e7378";
  const list = document.getElementById("comments-list");
  const input = document.getElementById("comment-input");
  const btn = document.getElementById("comment-submit");
  const overlay = document.getElementById("captcha-overlay");
  const captchaEl = document.getElementById("captcha-container");

  function fmtDate(ts) {
    const d = new Date(ts);
    return String(d.getMonth()+1).padStart(2,"0") + "." + String(d.getDate()).padStart(2,"0") + "." + String(d.getFullYear()).slice(-2);
  }

  function render(comments) {
    if (!comments.length) {
      list.innerHTML = '<tr class="flex mb-2"><td class="text-base !font-normal w-[9ch]">&nbsp;</td><td class="text-base !font-normal flex-1 ml-1.5 pl-2 text-muted-foreground">no comments yet</td></tr>';
      return;
    }
    list.innerHTML = comments.map(function(c) {
      return '<tr class="flex mb-3"><td class="text-base !font-normal w-[9ch]"><span class="flex font-medium align-baseline"><span class="ml-auto mr-1.5">' + fmtDate(c._creationTime) + '</span></span></td><td class="ml-0.5 text-base !font-normal flex-1 align-baseline">' + c.body.replace(/</g, "&lt;") + '</td></tr>';
    }).join("");
  }

  function load() {
    fetch(API + "?slug=" + encodeURIComponent(slug))
      .then(function(r) { return r.json(); })
      .then(render)
      .catch(function() { list.innerHTML = ""; });
  }

  input.addEventListener("input", function() {
    btn.disabled = !input.value.trim();
  });

  input.addEventListener("keydown", function(e) {
    if (e.key === "Enter" && input.value.trim()) showCaptcha();
  });

  btn.addEventListener("click", function() {
    if (input.value.trim()) showCaptcha();
  });

  overlay.addEventListener("click", function(e) {
    if (e.target === overlay) hideCaptcha();
  });

  var captchaId = null;
  function showCaptcha() {
    overlay.classList.remove("hidden");
    overlay.style.display = "flex";
    var isDark = document.documentElement.classList.contains("dark");
    if (captchaId !== null) {
      try { hcaptcha.reset(captchaId); } catch(e) {}
    }
    captchaId = hcaptcha.render(captchaEl, {
      sitekey: SITEKEY,
      theme: isDark ? "dark" : "light",
      callback: submit
    });
  }

  function hideCaptcha() {
    overlay.classList.add("hidden");
    overlay.style.display = "";
  }

  function submit(token) {
    hideCaptcha();
    btn.disabled = true;
    btn.textContent = "...";
    fetch(API, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ slug: slug, body: input.value.trim(), token: token })
    })
    .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
    .then(function(res) {
      if (!res.ok) alert(res.data.error || "Error");
      else { input.value = ""; load(); }
    })
    .catch(function() { alert("Network error"); })
    .finally(function() { btn.disabled = !input.value.trim(); btn.textContent = "submit"; });
  }

  load();
})();
</script>
