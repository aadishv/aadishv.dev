---
interface NavLink {
  label: string;
  href: string;
  className?: string;
}

interface Props {
  homeHref?: string;
  homeLabel?: string;
  navLinks: NavLink[];
  class?: string;
}

const {
  homeHref = "/",
  homeLabel = "Aadish Verma",
  navLinks,
  class: className,
} = Astro.props;
---

<header
  class:list={[
    "flex flex-col items-start gap-[0.3rem] pt-[1.1rem] sm:flex-row sm:items-baseline sm:justify-between sm:gap-8",
    className,
  ]}
>
  <a
    href={homeHref}
    class="m-0 whitespace-nowrap font-medium text-inherit no-underline hover:underline hover:underline-offset-[0.14em]"
  >
    {homeLabel}
  </a>
  <nav class="m-0 text-left text-[0.9rem] text-foreground/50 sm:text-right">
    {
      navLinks.map((link, i) => (
        <>
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            class="font-normal text-inherit no-underline hover:underline hover:underline-offset-[0.14em]"
          >
            {link.label}
          </a>
          {i < navLinks.length - 1 && (
            <span class="text-foreground/50" aria-hidden="true">
              {" "}
              /{" "}
            </span>
          )}
        </>
      ))
    }
  </nav>
</header>
