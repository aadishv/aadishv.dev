---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404: Not Found">
  <main class="container mx-auto py-20 px-4 flex flex-col items-center justify-center min-h-[60vh]">
    <div class="neo-card bg-white p-12 border-4 border-black shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] text-center max-w-lg w-full">
      <h1 class="text-8xl font-black mb-4 text-red-500">404</h1>
      <div class="h-2 bg-black w-full mb-8"></div>
      <p class="text-2xl font-bold mb-8">PAGE NOT FOUND</p>
      <p class="mb-8 font-medium">The page you are looking for has been moved, deleted, or possibly never existed.</p>
      
      <a href="/" class="inline-block bg-yellow-300 px-8 py-4 font-black border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all">
        RETURN HOME
      </a>
    </div>
  </main>
</Layout>
