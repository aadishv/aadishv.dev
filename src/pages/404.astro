---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404: Not Found">
  <main
    class="container mx-auto py-10 lg:px-52 text-center flex flex-col gap-6"
  >
    <h1 class="text-4xl">404</h1>
    <p>
      Sorry, the page you’re looking for doesn’t exist. Here's a cat picture to
      cheer you up.
    </p>
    <img src="https://cat.vexide.dev" />
    <a href="/" class="underline text-primary">Go back home</a>
  </main>
</Layout>
