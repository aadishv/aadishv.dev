---
import type { MarkdownInstance, GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { JSDOM } from "jsdom";
import { parseISO, format } from "date-fns";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import ConvexComments from "@/components/ConvexProvider";


export async function getStaticPaths({}: GetStaticPathsOptions) {
  const allContent = await getCollection("posts");
  const paths = allContent.map((post) => {
    const slug = getSlugFromPath(post.filePath ?? "");
    return {
      params: {
        slug: slug,
        id: post.id
      },
      props: { post, slug },
    };
  });

  return paths;
}

export const getSlugFromPath = (path: string): string => {
  return path.split("/").at(-1)!.replace(".md", "");
};

const { post, slug } = Astro.props;

const { headings, Content } = await render(post);

const date: Date = parseISO(post.data.date);
const formatted: string =
  post.data.date == "<top>" ? "" : format(date, "LLLL d, yyyy");

const isProject =
  post.data.categories && post.data.categories.includes("project");

const dom = new JSDOM(`
    <!doctype html><html><body>${post.rendered?.html}</body></html>
`);
const desc = Array.from(dom.window.document.querySelectorAll("p")).map(i => i.textContent).filter(Boolean)[0];

const baseUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : new URL(Astro.request.url).origin;
const ogImage = new URL(`/open-graph/${slug}.png`, baseUrl).toString();
---

<Layout title={post.data.title} description={desc} image={ogImage}>
  <div class="h-2 fixed bottom-0 left-0 transition-all bg-black z-50 duration-100" id="progress-bar"></div>
  <script>
    const progressBar = document.getElementById("progress-bar")!;
    const totalHeight = document.body.scrollHeight - window.innerHeight;
    window.addEventListener("scroll", () => {
      const scrollTop =
        window.pageYOffset || document.documentElement.scrollTop;
      const progress = (scrollTop / totalHeight) * 100;
      progressBar.style.width = `${progress}dvw`;
    });
  </script>
  
  <article class="container mx-auto px-4 max-w-4xl py-8">
    <div class="bg-white border-4 border-black p-8 md:p-12 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
      {
        post.data.image && (
          <div class="mb-8 border-2 border-black p-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            <img
              src={post.data.image}
              alt={post.data.title}
              class="w-full h-auto max-h-[400px] object-contain mx-auto"
            />
          </div>
        )
      }
      
      <header class="mb-10 border-b-4 border-black pb-6">
        <a
          href={post.data.link ?? `/${getSlugFromPath(post.filePath ?? "")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="!no-underline block group"
          transition:name={post.id}
        >
          <h1 class="text-4xl md:text-6xl font-black tracking-tighter mb-4 group-hover:text-blue-600 transition-colors">{post.data.title}</h1>
        </a>
        
        <div class="flex flex-wrap gap-4 items-center text-sm font-bold">
          <span class="bg-yellow-300 px-3 py-1 border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
            <time datetime={date.toString()}>{formatted}</time>
          </span>

          {
            post.body && (
              <span class="bg-purple-300 px-3 py-1 border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                {`${post.body.split(" ").length} words`}
              </span>
            )
          }
        </div>
      </header>

      {
        isProject && post.data.link && (
          <div class="mb-8">
            <a href={post.data.link} target="_blank" rel="noopener noreferrer" class="inline-block">
              <button class="bg-white px-6 py-3 font-black border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-all flex items-center gap-2">
                VIEW LIVE PROJECT <span class="text-xl">→</span>
              </button>
            </a>
          </div>
        )
      }

      <div class="prose prose-lg prose-slate max-w-none prose-headings:font-black prose-headings:border-b-2 prose-headings:border-black prose-headings:pb-2 prose-p:font-medium prose-a:text-blue-600 prose-a:decoration-2 prose-a:decoration-blue-400 hover:prose-a:bg-blue-100 prose-img:border-2 prose-img:border-black prose-img:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        <Content />
      </div>
      
      <div class="mt-16 pt-8 border-t-4 border-black">
        <h3 class="text-2xl font-black mb-6 bg-black text-white inline-block px-2">COMMENTS</h3>
        <ConvexComments slug={slug} client:only="react" />
      </div>
    </div>
  </article>
</Layout>
