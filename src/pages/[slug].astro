---
import type { MarkdownInstance, GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { JSDOM } from "jsdom";
import { parseISO, format } from "date-fns";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import ConvexComments from "@/components/ConvexProvider";

export async function getStaticPaths({}: GetStaticPathsOptions) {
  const allContent = await getCollection("posts");
  const paths = allContent.map((post) => {
    const slug = getSlugFromPath(post.filePath ?? "");
    return {
      params: {
        slug: slug,
        id: post.id,
      },
      props: { post, slug },
    };
  });

  return paths;
}

export const getSlugFromPath = (path: string): string => {
  return path.split("/").at(-1)!.replace(".md", "");
};

const { post, slug } = Astro.props;

const { headings, Content } = await render(post);

const date: Date = parseISO(post.data.date);
const formatted: string =
  post.data.date == "<top>" ? "" : format(date, "MM.dd.yy");

const isProject =
  post.data.categories && post.data.categories.includes("project");

const dom = new JSDOM(`
    <!doctype html><html><body>${post.rendered?.html}</body></html>
`);
const desc = Array.from(dom.window.document.querySelectorAll("p"))
  .map((i) => i.textContent)
  .filter(Boolean)[0];

const baseUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : new URL(Astro.request.url).origin;
const ogImage = new URL(`/open-graph/${slug}.png`, baseUrl).toString();
---

<Layout title={post.data.title} description={desc} image={ogImage} hideName>
  <main class="mt-2">
    <article class="flex gap-1 px-3">
      <table>
        <tr>
          <th
            class="!w-[500px] text-muted-foreground text-end pr-3 flex flex-col align-baseline"
          >
            <div class="">
              <h4 class="font-normal">
                <time datetime={date.toString()}>{formatted}</time>

                {
                  post.body && (
                    <span>• {`${post.body.split(" ").length} words`}</span>
                  )
                }
              </h4>

              {
                isProject && post.data.link && (
                  <span>
                    •
                    <a
                      href={post.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      live demo
                    </a>
                  </span>
                )
              }
            </div>
            <div class="flex-1"></div>
          </th>
          <th class="text-start align-baseline">
            <a
              href={`/${getSlugFromPath(post.filePath ?? "")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-aadish !font-normal tracking-tighter"
              transition:name={post.id}
            >
              <h1>{post.data.title}</h1>
            </a>
          </th>
        </tr>
        <tr>
          <td
            class="flex flex-col sticky top-3 [&_.toc-active]:text-aadish/70 text-end pr-4 align-baseline"
          >
            {
              headings.map((heading) => (
                <a
                  class="!font-normal toc"
                  style={{ marginLeft: `${(heading.depth - 2) / 2}rem` }}
                  href={`#${heading.slug}`}
                >
                  {heading.text.slice(0, -1)}
                </a>
              ))
            }
            <script is:inline>
            console.log("hi")
              document.addEventListener("DOMContentLoaded", () => {
                // 1. Select all the sections we want to track
                const toc = Array.from(document.querySelectorAll(".toc"));
                const sections = document.querySelectorAll(
                  "#content > h1, #content > h2, #content > h3",
                );

                // 2. Options for the IntersectionObserver
                const observerOptions = {
                  root: null, // use the viewport
                  rootMargin: "0px",
                  threshold: 0,
                };

                console.log(toc, sections);

                // 3. Create the observer
                const observer = new IntersectionObserver((entries) => {
                  entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                      const id = entry.target.id;
                      const nav = toc.filter(c => c.href.includes(id));
                      document.querySelector(".toc-active")?.classList.toggle("toc-active");
                      nav[0].classList.add("toc-active")
                      // // Remove 'active' class from ALL links
                      // navLinks.forEach(link => {
                      //     link.classList.remove('active');

                      //     // Add 'active' class ONLY to the matching link
                      //     if (link.getAttribute('href').includes(currentId)) {
                      //         link.classList.add('active');
                      //     }
                      // });
                    }
                  });
                }, observerOptions);

                // 4. Tell the observer to watch each section
                sections.forEach((section) => {
                  observer.observe(section);
                });
              });
            </script>
            <div class="flex-1">&nbsp;</div>
          </td>
          <td class="leading-8 align-baseline" id="content">
            <Content />
            <ConvexComments slug={slug} client:only="react" />
          </td>
        </tr>
      </table>
    </article>
  </main>
</Layout>
