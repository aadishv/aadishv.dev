---
import type { MarkdownInstance, GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { JSDOM } from "jsdom";
import { parseISO, format } from "date-fns";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import ConvexComments from "@/components/ConvexProvider";


export async function getStaticPaths({}: GetStaticPathsOptions) {
  const allContent = await getCollection("posts");
  const paths = allContent.map((post) => {
    const slug = getSlugFromPath(post.filePath ?? "");
    return {
      params: {
        slug: slug,
        id: post.id
      },
      props: { post, slug },
    };
  });

  return paths;
}

export const getSlugFromPath = (path: string): string => {
  return path.split("/").at(-1)!.replace(".md", "");
};

const { post, slug } = Astro.props;

const { headings, Content } = await render(post);

const date: Date = parseISO(post.data.date);
const formatted: string =
  post.data.date == "<top>" ? "" : format(date, "LLLL d, yyyy");

const isProject =
  post.data.categories && post.data.categories.includes("project");

const dom = new JSDOM(`
    <!doctype html><html><body>${post.rendered?.html}</body></html>
`);
const desc = Array.from(dom.window.document.querySelectorAll("p")).map(i => i.textContent).filter(Boolean)[0];

const baseUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : new URL(Astro.request.url).origin;
const ogImage = new URL(`/open-graph/${slug}.png`, baseUrl).toString();
---

<Layout title={post.data.title} description={desc} image={ogImage}>
  <article class="mx-auto max-w-[750px] leading-8 py-10">
    {
      post.data.image && (
        <div>
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-auto max-h-[400px] object-contain mx-auto"
          />
        </div>
      )
    }
    <main>
      <div class="text-xl">
        <a
          href={post.data.link ?? `/${getSlugFromPath(post.filePath ?? "")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="!no-underline aadish-none"
          transition:name={post.id}
        >
          <h1>{post.data.title}</h1>
        </a>
        <h4>
          <time datetime={date.toString()}>{formatted}</time>

          {
            post.body && (
              <span>
                ・<em>{`${post.body.split(" ").length} words`}</em>
              </span>
            )
          }
        </h4>
      </div>

      {
        isProject && post.data.link && (
          <div class="my-4">
            <a href={post.data.link} target="_blank" rel="noopener noreferrer">
              <Button variant="outline">View Live Project / Tool</Button>
            </a>
          </div>
        )
      }

      <div class="">
        <Content />
      </div>
      <ConvexComments slug={slug} client:only="react" />
    </main>
  </article>
</Layout>
