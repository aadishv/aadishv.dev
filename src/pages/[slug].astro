---
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import { parseISO, format } from "date-fns";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import Comments from "@/components/Comments";
import readingTime from "reading-time";

export async function getStaticPaths({}: GetStaticPathsOptions) {
  const allContent = await getCollection("posts");
  const paths = allContent.map((post) => {
    const slug = getSlugFromPath(post.filePath ?? "");
    return {
      params: { slug, id: post.id },
      props: { post, slug },
    };
  });
  return paths;
}

export const getSlugFromPath = (path: string): string => {
  return path.split("/").at(-1)!.replace(".md", "");
};

const { post, slug } = Astro.props;
const { headings, Content } = await render(post);

const date: Date = parseISO(post.data.date);
const formatted: string =
  post.data.date === "<top>" ? "" : format(date, "MMM d, yyyy");
const hasLink = !!post.data.link;
const mins = Math.ceil(readingTime(post.body ?? "").minutes);

const siteUrl = Astro.site ?? new URL("https://www.aadishv.dev");
const ogImage = new URL(`/open-graph/${slug}.png`, siteUrl).toString();

const filteredHeadings = headings.filter((h) => h.depth < 5);
const hasToc = filteredHeadings.length > 0;

const getTocIndentClass = (depth: number) => {
  switch (depth) {
    case 2:
      return "pl-[0.55rem]";
    case 3:
      return "pl-[1.1rem]";
    case 4:
      return "pl-[1.65rem]";
    default:
      return "pl-0";
  }
};

const navLinks = [
  {
    label: "résumé",
    href: "/resume.pdf",
    className: "bg-powerline-blue text-white",
  },
  {
    label: "background",
    href: "/background",
    className: "bg-powerline-green text-white",
  },
  {
    label: "notes",
    href: "/notes",
    className: "bg-powerline-amber text-black",
  },
  {
    label: "github",
    href: "https://github.com/aadishv",
    className: "bg-powerline-purple text-white",
  },
  {
    label: "email",
    href: "mailto:mail@aadishv.dev",
    className: "bg-powerline-red text-white",
  },
];
---

<Layout title={post.data.title} image={ogImage} hideName>
  <main class="mx-auto max-w-[54rem] px-4 pb-12 font-mono text-base leading-6 text-foreground sm:px-8 sm:pb-20">
    <TopBar navLinks={navLinks} />

    <div class="py-7 pb-5">
      <h1
        class="m-0 text-[1.55rem] leading-[1.25] font-semibold tracking-[-0.025em] font-sans"
        transition:name={post.id}
      >
        {post.data.title}
      </h1>
      <div class="mt-[0.6rem] flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.82rem] text-foreground/70">
        {
          formatted && (
            <time datetime={date.toISOString()} transition:name={`date-${post.id}`}>
              {formatted}
            </time>
          )
        }
        <span>{mins} min read</span>
        {
          hasLink && (
            <a
              href={post.data.link}
              target="_blank"
              rel="noreferrer"
              class="inline-flex min-h-8 items-center whitespace-nowrap bg-powerline-cyan px-[0.72rem] py-[0.34rem] text-white no-underline hover:no-underline"
            >
              live demo
            </a>
          )
        }
      </div>
    </div>

    <div class="pt-1 xl:relative">
      {
        hasToc && (
          <aside
            class="hidden xl:absolute xl:top-5 xl:right-full xl:mr-10 xl:flex xl:w-44 2xl:w-48"
            aria-label="Table of contents"
          >
            <div class="sticky top-7 flex w-full flex-col gap-[0.02rem]">
              {
                filteredHeadings.map((heading) => (
                  <a
                    class:list={[
                      "block overflow-hidden text-ellipsis whitespace-nowrap rounded-sm px-2 py-[0.18rem] text-[0.78rem] leading-[1.45] text-foreground/50 opacity-75 no-underline transition-[opacity,color] duration-100 hover:text-foreground hover:opacity-100 aria-[current=true]:font-medium aria-[current=true]:text-foreground aria-[current=true]:opacity-100",
                      getTocIndentClass(heading.depth),
                    ]}
                    href={`#${heading.slug}`}
                  >
                    {heading.text.replace(/#$/, "").trim()}
                  </a>
                ))
              }
            </div>
            <script is:inline>
              const setupToc = () => {
                const links = Array.from(document.querySelectorAll("aside[aria-label='Table of contents'] a"));
                const sections = document.querySelectorAll(
                  "#content h1, #content h2, #content h3, #content h4, #content h5, #content h6, #footnote-label",
                );

                if (!links.length || !sections.length) return;

                const observer = new IntersectionObserver(
                  (entries) => {
                    entries.forEach((entry) => {
                      if (entry.isIntersecting) {
                        links.forEach((link) => link.removeAttribute("aria-current"));
                        links
                          .find((link) => link.getAttribute("href") === `#${entry.target.id}`)
                          ?.setAttribute("aria-current", "true");
                      }
                    });
                  },
                  { rootMargin: "-5% 0px -85% 0px" },
                );

                sections.forEach((section) => observer.observe(section));
              };

              document.addEventListener("astro:page-load", setupToc);
            </script>
          </aside>
        )
      }

      <div>
        <div
          class="prose max-w-[54rem] min-w-0 text-base leading-[1.7] font-mono [&>*:first-child]:mt-0 [&_a]:break-anywhere [&_a:not(.aadish-none)]:font-normal [&_a:not(.aadish-none)]:text-inherit [&_a:not(.aadish-none)]:underline [&_a:not(.aadish-none)]:decoration-current [&_a:not(.aadish-none)]:underline-offset-[0.14em] [&_a:not(.aadish-none):hover]:no-underline [&_h1]:font-mono [&_h1]:font-semibold [&_h1]:tracking-[-0.02em] [&_h2]:font-mono [&_h2]:font-semibold [&_h2]:tracking-[-0.02em] [&_h3]:font-mono [&_h3]:font-semibold [&_h3]:tracking-[-0.02em] [&_h4]:font-mono [&_h4]:font-semibold [&_h4]:tracking-[-0.02em] [&_h5]:font-mono [&_h5]:font-semibold [&_h5]:tracking-[-0.02em] [&_h6]:font-mono [&_h6]:font-semibold [&_h6]:tracking-[-0.02em] lg:[&_img]:max-w-[50%] [&_img]:mx-auto"
          id="content"
        >
          <Content />
          <Comments client:only="solid-js" slug={slug} />
        </div>
      </div>
    </div>
  </main>
</Layout>
