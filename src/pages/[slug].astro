---
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import { JSDOM } from "jsdom";
import { parseISO, format } from "date-fns";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import ConvexComments from "@/components/ConvexProvider";

export async function getStaticPaths({}: GetStaticPathsOptions) {
  const allContent = await getCollection("posts");
  const paths = allContent.map((post) => {
    const slug = getSlugFromPath(post.filePath ?? "");
    return {
      params: {
        slug: slug,
        id: post.id,
      },
      props: { post, slug },
    };
  });

  return paths;
}

export const getSlugFromPath = (path: string): string => {
  return path.split("/").at(-1)!.replace(".md", "");
};

const { post, slug } = Astro.props;

const { headings, Content } = await render(post);

const date: Date = parseISO(post.data.date);
const formatted: string =
  post.data.date == "<top>" ? "" : format(date, "MM.dd.yy");

const isProject =
  post.data.categories && post.data.categories.includes("project");

const dom = new JSDOM(`
    <!doctype html><html><body>${post.rendered?.html}</body></html>
`);
const desc = Array.from(dom.window.document.querySelectorAll("p"))
  .map((i) => i.textContent)
  .filter(Boolean)[0];

const baseUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : new URL(Astro.request.url).origin;
const ogImage = new URL(`/open-graph/${slug}.png`, baseUrl).toString();
---

<Layout title={post.data.title} description={desc} image={ogImage} hideName>
    <table>
      <tr>
        <th class="w-[300px] hidden lg:flex text-muted-foreground mr-[10px] align-baseline px-3">
          <h4 class="font-normal">
            <time datetime={date.toString()}>{formatted}</time>

            {
              post.body && (
                <span>{`• ${post.body.split(" ").length} words`}</span>
              )
            }
          </h4>
        </th>
        <th class="w-screen lg:w-[calc(100vw-300px)] text-start align-baseline flex-1">
          <a
            href={`/${getSlugFromPath(post.filePath ?? "")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-aadish !font-normal tracking-tighter"
            transition:name={post.id}
          >
            <h1>{post.data.title}</h1>
          </a>
        </th>
      </tr>
      <tr>
        <td
          class="w-[300px] mr-[10px] hidden lg:flex flex-col sticky top-3 [&_.toc-active]:!text-aadish pr-4 align-baseline"
        >
          {
            isProject && post.data.link && (
              <p>
                <a
                  href={post.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  live demo
                </a>
              </p>
            )
          }
          {
            headings
              .filter((heading) => heading.depth < 5)
              .map((heading) => (
                <a
                  class="toc pr-2 my-1 !text-muted-foreground/70 text-ellipsis text-nowrap overflow-hidden whitespace-nowrap"
                  href={`#${heading.slug}`}
                >
                  <span class="opacity-0">{"#".repeat(heading.depth - 1) + " "}</span>
                  {heading.text.slice(0, -1)}
                </a>
              ))
          }
          <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
              // 1. Select all the sections we want to track
              const toc = Array.from(document.querySelectorAll(".toc"));
              const sections = document.querySelectorAll(
                "#content > h1, #content > h2, #content > h3, #content > h4, #content > h5, #content > h6, #footnote-label",
              );

              const observerOptions = {
                root: null, // use the viewport
                rootMargin: "0px",
                threshold: 0,
              };

              const observer = new IntersectionObserver((entries) => {
                let thing = null;
                entries.toReversed().forEach((entry) => {
                  if (entry.isIntersecting) {
                    thing = entry.target.id;
                  }
                });
                if (thing) {
                  const nav = toc.filter((c) => c.href.includes(thing));
                  if (nav.length > 0) {
                    document
                      .querySelector(".toc-active")
                      ?.classList.toggle("toc-active");
                    nav[0].classList.add("toc-active");
                  }
                }
              }, observerOptions);

              sections.forEach((section) => {
                observer.observe(section);
              });
            });
          </script>
        </td>
        <td
          class="w-screen lg:w-[calc(100vw-300px)] [&>*]:!text-wrap [&>*]:!w-full lg:[&_img]:max-w-[50vw] [&_img]:max-w-[90vw]  [&_img]:mx-auto align-baseline flex-1"
          id="content"
        >
          <Content />
          <ConvexComments client:load slug={slug} />
        </td>
      </tr>
    </table>
</Layout>
