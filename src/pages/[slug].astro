---
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import { JSDOM } from "jsdom";
import { parseISO, format } from "date-fns";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import ConvexComments from "@/components/ConvexProvider";
import readingTime from "reading-time";

export async function getStaticPaths({}: GetStaticPathsOptions) {
  const allContent = await getCollection("posts");
  const paths = allContent.map((post) => {
    const slug = getSlugFromPath(post.filePath ?? "");
    return {
      params: { slug, id: post.id },
      props: { post, slug },
    };
  });
  return paths;
}

export const getSlugFromPath = (path: string): string => {
  return path.split("/").at(-1)!.replace(".md", "");
};

const { post, slug } = Astro.props;
const { headings, Content } = await render(post);

const date: Date = parseISO(post.data.date);
const formatted: string =
  post.data.date === "<top>" ? "" : format(date, "MMM d, yyyy");
const hasLink = !!post.data.link;

const dom = new JSDOM(
  `<!doctype html><html><body>${post.rendered?.html}</body></html>`,
);
const desc = Array.from(dom.window.document.querySelectorAll("p"))
  .map((i) => i.textContent)
  .filter(Boolean)[0];
const text = dom.window.document.body.textContent ?? "";
const mins = Math.ceil(readingTime(text).minutes);

const baseUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : new URL(Astro.request.url).origin;
const ogImage = new URL(`/open-graph/${slug}.png`, baseUrl).toString();

const filteredHeadings = headings.filter((h) => h.depth < 5);
const hasToc = filteredHeadings.length > 0;

const getTocIndentClass = (depth: number) => {
  switch (depth) {
    case 2:
      return "pl-[0.55rem]";
    case 3:
      return "pl-[1.1rem]";
    case 4:
      return "pl-[1.65rem]";
    default:
      return "pl-0";
  }
};

const navLinks = [
  { label: "résumé", href: "/resume.pdf" },
  { label: "background", href: "/background" },
  { label: "notes", href: "/notes" },
  { label: "github", href: "https://github.com/aadishv" },
  { label: "email", href: "mailto:mail@aadishv.dev" },
];
---

<Layout title={post.data.title} description={desc} image={ogImage} hideName>
  <main class="px-4 pb-12 text-base leading-6 text-foreground sm:px-8 sm:pb-20 font-sans">
    <header class="mx-auto flex max-w-[54rem] flex-col items-start gap-[0.3rem] border-b border-border/70 py-[1.1rem] sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
      <a
        href="/"
        class="m-0 whitespace-nowrap font-semibold text-inherit no-underline hover:underline hover:underline-offset-[0.14em]"
      >
        Aadish Verma
      </a>
      <nav class="m-0 text-left text-[0.9rem] text-foreground/50 sm:text-right">
        {
          navLinks.map((link, i) => (
            <>
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                class="font-normal text-inherit no-underline hover:underline hover:underline-offset-[0.14em]"
              >
                {link.label}
              </a>
              {
                i < navLinks.length - 1 && (
                  <span class="text-foreground/50" aria-hidden="true"> / </span>
                )
              }
            </>
          ))
        }
      </nav>
    </header>

    <div class="mx-auto max-w-[54rem] border-b border-border/70 py-7 pb-5">
      <h1
        class="m-0 text-[1.55rem] leading-[1.25] font-semibold tracking-[-0.025em] font-sans"
        transition:name={post.id}
      >
        {post.data.title}
      </h1>
      <p class="mt-[0.35rem] text-[0.88rem] text-foreground/50">
        {
          formatted && (
            <time datetime={date.toISOString()} transition:name={`date-${post.id}`}>
              {formatted}
            </time>
          )
        }
        {formatted && <span aria-hidden="true"> · </span>}
        <span>{mins} min read</span>
        {
          hasLink && (
            <>
              <span aria-hidden="true"> · </span>
              <a
                href={post.data.link}
                target="_blank"
                rel="noreferrer"
                class="font-normal text-inherit underline underline-offset-[0.14em] hover:no-underline"
              >
                live demo
              </a>
            </>
          )
        }
      </p>
    </div>

    <div
      class:list={[
        "mx-auto max-w-[54rem] pt-7",
        hasToc &&
          "xl:grid xl:max-w-[calc(54rem+9rem+9rem+4rem)] xl:grid-cols-[9rem_2rem_54rem_2rem_9rem] xl:items-start",
      ]}
    >
      {
        hasToc && (
          <aside
            class="hidden xl:col-start-1 xl:mt-[0.35rem] xl:flex xl:w-36 xl:justify-self-end"
            aria-label="Table of contents"
          >
            <div class="sticky top-7 flex w-full flex-col gap-[0.08rem]">
              {
                filteredHeadings.map((heading) => (
                  <a
                    class:list={[
                      "block overflow-hidden text-ellipsis whitespace-nowrap text-[0.78rem] leading-6 text-foreground/50 opacity-75 no-underline transition-[opacity,color] duration-100 hover:text-foreground hover:opacity-100 aria-[current=true]:font-medium aria-[current=true]:text-foreground aria-[current=true]:opacity-100",
                      getTocIndentClass(heading.depth),
                    ]}
                    href={`#${heading.slug}`}
                  >
                    {heading.text.replace(/#$/, "").trim()}
                  </a>
                ))
              }
            </div>
            <script is:inline>
              const setupToc = () => {
                const links = Array.from(document.querySelectorAll("aside[aria-label='Table of contents'] a"));
                const sections = document.querySelectorAll(
                  "#content h1, #content h2, #content h3, #content h4, #content h5, #content h6, #footnote-label",
                );

                if (!links.length || !sections.length) return;

                const observer = new IntersectionObserver(
                  (entries) => {
                    entries.forEach((entry) => {
                      if (entry.isIntersecting) {
                        links.forEach((link) => link.removeAttribute("aria-current"));
                        links
                          .find((link) => link.getAttribute("href") === `#${entry.target.id}`)
                          ?.setAttribute("aria-current", "true");
                      }
                    });
                  },
                  { rootMargin: "-5% 0px -85% 0px" },
                );

                sections.forEach((section) => observer.observe(section));
              };

              document.addEventListener("astro:page-load", setupToc);
            </script>
          </aside>
        )
      }

      <div class:list={["mx-auto max-w-[54rem]", hasToc && "xl:col-start-3"]}>
        <div
          class="prose max-w-[54rem] min-w-0 text-base leading-[1.7] font-sans [&>*:first-child]:mt-0 [&_a]:break-anywhere [&_a:not(.aadish-none)]:font-normal [&_a:not(.aadish-none)]:text-inherit [&_a:not(.aadish-none)]:underline [&_a:not(.aadish-none)]:decoration-current [&_a:not(.aadish-none)]:underline-offset-[0.14em] [&_a:not(.aadish-none):hover]:no-underline [&_h1]:font-sans [&_h1]:font-semibold [&_h1]:tracking-[-0.02em] [&_h2]:font-sans [&_h2]:font-semibold [&_h2]:tracking-[-0.02em] [&_h3]:font-sans [&_h3]:font-semibold [&_h3]:tracking-[-0.02em] [&_h4]:font-sans [&_h4]:font-semibold [&_h4]:tracking-[-0.02em] [&_h5]:font-sans [&_h5]:font-semibold [&_h5]:tracking-[-0.02em] [&_h6]:font-sans [&_h6]:font-semibold [&_h6]:tracking-[-0.02em] lg:[&_img]:max-w-[50%] [&_img]:mx-auto"
          id="content"
        >
          <Content />
          <ConvexComments client:load slug={slug} />
        </div>
      </div>
    </div>
  </main>
</Layout>
