---
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import { JSDOM } from "jsdom";
import { parseISO, format } from "date-fns";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import ConvexComments from "@/components/ConvexProvider";
import readingTime from "reading-time";

export async function getStaticPaths({}: GetStaticPathsOptions) {
  const allContent = await getCollection("posts");
  const paths = allContent.map((post) => {
    const slug = getSlugFromPath(post.filePath ?? "");
    return {
      params: {
        slug: slug,
        id: post.id,
      },
      props: { post, slug },
    };
  });

  return paths;
}

export const getSlugFromPath = (path: string): string => {
  return path.split("/").at(-1)!.replace(".md", "");
};

const { post, slug } = Astro.props;

const { headings, Content } = await render(post);

const date: Date = parseISO(post.data.date);
const formatted: string =
  post.data.date == "<top>" ? "" : format(date, "MM.dd.yy");

const hasLink = !!post.data.link;

const dom = new JSDOM(`
    <!doctype html><html><body>${post.rendered?.html}</body></html>
`);
const desc = Array.from(dom.window.document.querySelectorAll("p"))
  .map((i) => i.textContent)
  .filter(Boolean)[0];
const text = dom.window.document.body.textContent ?? "";

const timeToRead = readingTime(text);

const baseUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : new URL(Astro.request.url).origin;
const ogImage = new URL(`/open-graph/${slug}.png`, baseUrl).toString();
---

<Layout title={post.data.title} description={desc} image={ogImage} hideName>
  <table class="mt-5 lg:mt-24">
    <tr>
      <th
        class="w-[16rem] ml-[6rem] hidden lg:block font-normal text-muted-foreground mr-[10px] align-baseline pr-3 text-start"
      >
        <time datetime={date.toString()} transition:name={`date-${post.id}`}
          >{formatted}</time
        >
        {` • ${Math.ceil(timeToRead.minutes)} min read`}
      </th>
      <th class="lg:pr-[6rem] px-5 lg:mx-0 text-start align-baseline flex-1">
        <a
          href={`/${getSlugFromPath(post.filePath ?? "")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-aadish !font-medium !no-underline"
          transition:name={post.id}
        >
          <h1>{post.data.title}</h1>
        </a>
        <i class="font-normal">from the blog of <a href="/">Aadish Verma</a></i>
      </th>
    </tr>
    <tr>
      <td
        class="w-[16rem] ml-[6rem] hidden lg:flex pr-3 flex-col sticky top-3 [&_.toc-active]:!text-aadish align-baseline"
      >
        {
          hasLink && (
            <p>
              <a
                href={post.data.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                live demo
              </a>
            </p>
          )
        }
        {
          headings
            .filter((heading) => heading.depth < 5)
            .map((heading) => (
              <a
                class="toc pr-2 my-1 !text-muted-foreground/70 text-ellipsis text-nowrap overflow-hidden whitespace-nowrap"
                href={`#${heading.slug}`}
              >
                <span class="opacity-0">
                  {"#".repeat(heading.depth - 2) + " "}
                </span>
                {heading.text.slice(0, -1)}
              </a>
            ))
        }
        <script is:inline>
          const setupToc = () => {
            const toc = Array.from(document.querySelectorAll(".toc"));
            const sections = document.querySelectorAll(
              "#content h1, #content h2, #content h3, #content h4, #content h5, #content h6, #footnote-label",
            );

            if (toc.length === 0 || sections.length === 0) return;

            const observerOptions = {
              rootMargin: "-5% 0px -85% 0px",
              threshold: 0,
            };

            const observer = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const id = entry.target.id;
                  const nav = toc.find(
                    (c) => c.getAttribute("href") === `#${id}`,
                  );
                  if (nav) {
                    document
                      .querySelector(".toc-active")
                      ?.classList.remove("toc-active");
                    nav.classList.add("toc-active");
                  }
                }
              });
            }, observerOptions);

            sections.forEach((section) => observer.observe(section));
          };

          document.addEventListener("astro:page-load", setupToc);
        </script>
      </td>
      <td
        class="lg:pr-[6rem] pt-2 px-5 lg:mx-0 align-baseline flex-1"
        id="content"
      >
        <div
          class="!w-full [&_*]:text-wrap [&_a]:!break-anywhere lg:[&_img]:max-w-[50%] [&_img]:mx-auto"
        >
          <Content />
        </div>
        <ConvexComments client:load slug={slug} />
      </td>
    </tr>
  </table>
</Layout>
