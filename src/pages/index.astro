---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { parseISO, format } from "date-fns";

const getSlugFromPath = (path: string): string => {
  const parts = path.split("/");
  const filename = parts.pop() || "";
  return filename.replace(".md", "");
};

const allEntries = await getCollection("posts");
const entries = allEntries
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .filter((p) => p.data.hidden !== true);

const navLinks = [
  { label: "résumé", href: "/resume.pdf" },
  { label: "background", href: "/background" },
  { label: "notes", href: "/notes" },
  { label: "github", href: "https://github.com/aadishv" },
  { label: "email", href: "mailto:mail@aadishv.dev" },
];
---

<Layout
  title="Aadish Verma"
  hideName={true}
  description="Aadish Verma builds software for robotics, students, and small teams."
>
  <main class="mx-auto max-w-[54rem] px-4 pb-12 text-base leading-6 text-foreground sm:px-8 sm:pb-16 font-sans">
    <header class="flex flex-col items-start gap-[0.3rem] border-b border-border/70 py-[1.1rem] sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
      <span class="m-0 whitespace-nowrap font-semibold">Aadish Verma</span>
      <nav class="m-0 text-left text-[0.9rem] text-foreground/50 sm:text-right">
        {
          navLinks.map((link, i) => (
            <>
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                class="font-normal text-inherit no-underline hover:underline hover:underline-offset-[0.14em]"
              >
                {link.label}
              </a>
              {
                i < navLinks.length - 1 && (
                  <span class="text-foreground/50" aria-hidden="true"> / </span>
                )
              }
            </>
          ))
        }
      </nav>
    </header>

    <section class="max-w-[44rem] py-8">
      <p class="m-0 text-inherit">
        I'm a freshman at Stanford Online High School in the Bay Area,
        currently working as a founding engineer at <a
          href="https://www.jvcopilot.ai/"
          target="_blank"
          rel="noreferrer"
          class="font-normal text-inherit no-underline underline-offset-[0.14em] hover:underline"
        >JV Copilot</a>. <a
          href="/background"
          class="font-normal text-inherit no-underline underline-offset-[0.14em] hover:underline"
        >Here's</a> a bit more about me.
      </p>
    </section>

    <section>
      <ul class="m-0 list-none p-0">
        {
          entries.map((entry) => (
            <li class="m-0 list-none p-0">
              <a
                href={`/${getSlugFromPath(entry.filePath ?? "")}`}
                transition:name={entry.id}
                class="group grid w-full grid-cols-1 items-baseline gap-[0.05rem] py-[0.3rem] font-normal text-inherit no-underline sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-4"
              >
                <time
                  datetime={parseISO(entry.data.date).toISOString()}
                  transition:name={`date-${entry.id}`}
                  class="m-0 whitespace-nowrap text-[0.88rem] text-foreground/50 tabular-nums"
                >
                  {format(parseISO(entry.data.date), "MMM d, yyyy")}
                </time>
                <span class="m-0 text-[0.95rem] group-hover:underline group-hover:underline-offset-[0.14em]">
                  {entry.data.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
