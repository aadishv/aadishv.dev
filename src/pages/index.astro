---
import Layout from "../layouts/Layout.astro";
import "@/styles/globals.css";
import { getCollection } from "astro:content";
import { Badge } from "@/components/ui/badge";
import { parseISO, format } from "date-fns";
import { Chrome, FileText, Github, Globe } from "lucide-react";
import { Button } from "@/components/ui/button";
const getSlugFromPath = (path: string): string => {
  const parts = path.split("/");
  const filename = parts.pop() || "";
  return filename.replace(".md", "");
};
function formatDate(dateString: string) {
  try {
    return new Date(dateString).toLocaleDateString(undefined, {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  } catch {
    return dateString;
  }
}
let allEntries = await getCollection("posts");
const entries = allEntries
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .filter((p) => p.data.hidden !== true);

let value = 0;
const delay = () => {
  value += 50;
  return `
  animation-delay: ${value}ms;
  animation-name: appear !important;
  animation-timing-function: ease-in-out;
  animation-iteration-count: 1;
  animation-duration: 250ms;
  animation-fill-mode: forwards;
  opacity: 0;
`;
};
---

<Layout title="Aadish Verma" hideName={true}>
  <main class="container mx-auto">
    <h3 style={delay()}>hi, I'm Aadish!</h3>
    <hr class="border-aadish/50" />
    <div class="flex flex-col lg:flex-row-reverse lg:gap-4">
      <div class="w-full pt-1 pb-10">
          <p style={delay()} class="mt-0 pt-0">
            I’m a freshman at Stanford Online High School and passionate programmer.
          </p>
          <p style={delay()}>
            {
              "(If you're looking for a list of skills or programming languages, you aren't going to find it. Such a list would grow every day 🙂)"
            }
          </p>
          <p style={delay()}>
            Check out my <a href="/background">programming background</a> for a few
            notable things I've done.
          </p>
          <p style={delay()}>
            Contact me!
            <br /><a href="mailto:aadish@ohs.stanford.edu">email</a>
            <br /><a href="https://github.com/aadishv" target="_blank">github</a
            >
            <br /><a href="https://x.com/aadishvdotdev" target="_blank"
              >twitter (views my own)</a
            >
          </p>
          <div class="flex flex-col-reverse lg:flex-col space-y-3">
          <p style={delay()}>
              <span class="lg:inline hidden">←</span>
            {"check out my blog!"}
            <span class="lg:hidden inline">↓</span>
          </p>
          <ul class="space-y-3">
          <p style={delay()}>A few cool projects I've worked on (not an exhuastive list!):</p>

          <div style={delay()} class="w-full border rounded-xl p-2 flex gap-2 flex-wrap lg:flex-nowrap flex-row">
              <img src="https://avatars.githubusercontent.com/u/228060980?s=200&v=4" class="!size-16 rounded-lg" />
              <p class="w-full my-auto pr-4"><b>{"Dotlist: "}</b>a family of open-source productivity managers</p>
              <a href="/llm-1" class="p-1 border border-border rounded-lg mt-auto aadish-none"><FileText size={32} /></a>
              <a href="https://dotlist.edwrdq.xyz/" class="p-1 border border-border rounded-lg mt-auto aadish-none"><Globe size={32} /></a>
              <a href="https://github.com/dotlists" class="p-1 border border-border rounded-lg mt-auto aadish-none"><Github size={32} /></a>
          </div>

          <div style={delay()} class="w-full border rounded-xl p-2 flex gap-2 flex-wrap lg:flex-nowrap flex-row">
              <img src="/tools/vairc/vairc.png" class="!h-16 !w-[7.3125rem] px-2 rounded-lg" />
              <p class="w-full my-auto pr-4"><b>{"3151A: "}</b>innovated a tech stack to train, run, and integrate custom AI and logic models from scratch</p>
              <a href="/robotics-5" class="p-1 border border-border rounded-lg mt-auto aadish-none"><FileText size={32} /></a>
              <a href="https://github.com/aadishv/AIWorlds" class="p-1 border border-border rounded-lg mt-auto aadish-none"><Github size={32} /></a>
          </div>

          <div style={delay()} class="w-full border rounded-xl bg-[#ff453b] text-white p-2 flex gap-2 flex-wrap lg:flex-nowrap flex-row">
              <img src="https://avatars.githubusercontent.com/u/217141257?s=400" class="!size-16 rounded-lg" />
              <p class="w-full pr-4 my-auto"><b>{"Venice: "}</b>an open source Micropython runtime for the VEX V5 brain</p>
              <a href="https://venice.fibn.cc" class="p-1 border border-border rounded-lg mt-auto aadish-none"><Globe size={32} /></a>
              <a href="https://github.com/venice-v5" class="p-1 border border-border rounded-lg mt-auto aadish-none"><Github size={32} /></a>
          </div>

          <div style={delay()} class="w-full border rounded-xl bg-[#00261a] text-white p-2 flex gap-2 flex-wrap lg:flex-nowrap flex-row">
              <img src="/ohs-ac-intro.md/1.png" class="!size-16 rounded-lg" />
              <p class="w-full pr-4 my-auto"><b>{"OHS AC Utils: "}</b>Chrome extension for OHS students that adds downloading options & AI features to lecture recordings</p>
              <a href="/introducing-ohs-ac-utils" class="p-1 border border-border rounded-lg mt-auto aadish-none"><FileText size={32} /></a>
              <a href="https://chromewebstore.google.com/detail/ohs-ac-utilities/mcnjeemajaoopeejjbfiieaepibmbjne" class="p-1 border border-border rounded-lg mt-auto aadish-none"><Chrome size={32} /></a>
              <a href="https://github.com/aadishv/ohs-ac-utils" class="p-1 border border-border rounded-lg mt-auto aadish-none"><Github size={32} /></a>
          </div>
          </ul>
          </div>
      </div>
      <ul class="space-y-6 w-full mt-0 pb-10">
        {
          entries.map((entry) => (
            <div style={delay()}>
              <span class="text-xl">
                <a
                  href={"/" + getSlugFromPath(entry.filePath ?? "")}
                  class="underline hover:decoration-none"
                  transition:name={entry.id}
                >
                  {entry.data.title}
                </a>
                {entry.data.categories.map((c: string) => (
                  <Badge variant="outline" className="ml-2 font-normal">
                    {c}
                  </Badge>
                ))}
              </span>
              <time
                class="block"
                datetime={parseISO(entry.data.date).toString()}
              >
                {format(parseISO(entry.data.date), "LLLL d, yyyy")}
              </time>
              {entry.data.description && (
                <p class="text-sm text-muted-foreground line-clamp-3">
                  {entry.data.description}
                </p>
              )}
            </div>
          ))
        }
      </ul>
    </div>
  </main>
</Layout>
