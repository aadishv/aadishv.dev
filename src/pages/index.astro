---
import Layout from "../layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import { getCollection } from "astro:content";
import { parseISO, format } from "date-fns";

const getSlugFromPath = (path: string): string => {
  const parts = path.split("/");
  const filename = parts.pop() || "";
  return filename.replace(/(?:\.(?:svg|html))?\.[^.]+$/, "");
};

const allEntries = await getCollection("posts");
const entries = allEntries
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .filter((p) => p.data.hidden !== true);

const navLinks = [
  { label: "résumé", href: "/resume.pdf" },
  { label: "notes", href: "/notes" },
  { label: "github", href: "https://github.com/aadishv" },
  { label: "email", href: "mailto:mail@aadishv.dev" },
];
---

<Layout
  title="Aadish Verma"
  hideName={true}
  description="Aadish Verma builds software for robotics, students, and small teams."
>
  <main
    class="mx-auto max-w-216 px-4 pb-12 font-sans text-base leading-6 text-foreground sm:px-8 sm:pb-16"
  >
    <TopBar navLinks={navLinks} />

    <section class="max-w-176 py-8">
      <p class="m-0 text-inherit">
        I&apos;m a freshman at Stanford Online High School in the Bay Area,
        currently working as a founding engineer at <a
          href="https://www.jvcopilot.ai/"
          target="_blank"
          rel="noreferrer"
          class="font-normal text-inherit underline underline-offset-[0.14em] hover:no-underline"
          >JV Copilot</a
        > and software co-lead for <a
          href="https://projectpixelorbital.com"
          target="_blank"
          rel="noreferrer"
          class="font-normal text-inherit underline underline-offset-[0.14em] hover:no-underline"
          >Project Pixel Orbital</a
        >.
      </p>
    </section>

    <section>
      <ul class="m-0 list-none p-0">
        {
          entries.map((entry) => (
            <li class="m-0 list-none p-0">
              <a
                href={`/${getSlugFromPath(entry.filePath ?? "")}`}
                transition:name={entry.id}
                class="group grid w-full grid-cols-1 items-baseline gap-[0.4rem] rounded-md py-[0.45rem] font-normal text-inherit no-underline sm:grid-cols-[8.6rem_minmax(0,1fr)] sm:gap-4"
              >
                <time
                  datetime={parseISO(entry.data.date).toISOString()}
                  transition:name={`date-${entry.id}`}
                  class="m-0 w-fit text-[0.8rem] tabular-nums text-foreground/60"
                >
                  {format(parseISO(entry.data.date), "MMM d, yyyy")}
                </time>
                <span class="m-0 text-[0.95rem] group-hover:underline group-hover:underline-offset-[0.14em]">
                  {entry.data.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
