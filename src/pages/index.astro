---
import Layout from "../layouts/Layout.astro";
import "@/styles/globals.css";
import { getCollection } from "astro:content";
import { parseISO, format } from "date-fns";
import { ArrowUpRight, Terminal, Cpu, Globe, Code } from "lucide-react";

const getSlugFromPath = (path: string): string => {
  const parts = path.split("/");
  const filename = parts.pop() || "";
  return filename.replace(".md", "");
};

let allEntries = await getCollection("posts");
const entries = allEntries
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .filter((p) => p.data.hidden !== true);

const projects = [
  {
    name: "DOTLIST",
    desc: "Productivity Suite",
    tech: "NEXT.JS",
    href: "https://dotlist.edwrdq.xyz/",
    icon: Globe,
    color: "bg-blue-300"
  },
  {
    name: "3151A",
    desc: "AI & Logic Stack",
    tech: "PYTHON",
    href: "https://github.com/aadishv/AIWorlds",
    icon: Cpu,
    color: "bg-green-300"
  },
  {
    name: "VENICE",
    desc: "VEX Runtime",
    tech: "MICROPYTHON",
    href: "https://venice.fibn.cc",
    icon: Terminal,
    color: "bg-purple-300"
  },
  {
    name: "OHS UTILS",
    desc: "Student Tools",
    tech: "CHROME EXT",
    href: "https://chromewebstore.google.com/detail/ohs-ac-utilities/mcnjeemajaoopeejjbfiieaepibmbjne",
    icon: Code,
    color: "bg-yellow-300"
  },
];
---

<Layout title="Aadish Verma" hideName={true} description="A freshman and avid programmer">
  <main class="container mx-auto px-4 max-w-5xl py-12">
    
    {/* Hero Section */}
    <header class="mb-20">
      <div class="neo-card bg-white p-8 md:p-12 mb-8 border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
        <h1 class="text-5xl md:text-8xl font-black tracking-tighter mb-6 leading-[0.9]">
          AADISH<br/>VERMA
        </h1>
        <div class="flex flex-col md:flex-row gap-6 md:items-center text-lg font-bold border-t-4 border-black pt-6">
          <span class="bg-yellow-300 px-3 py-1 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            FULL STACK DEV
          </span>
          <span class="bg-purple-300 px-3 py-1 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            STUDENT
          </span>
          <span class="bg-blue-300 px-3 py-1 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            BUILDER
          </span>
        </div>
        <p class="mt-8 text-xl font-medium max-w-2xl">
          Founding Engineer at <a href="https://www.jvcopilot.ai/" class="underline decoration-4 decoration-blue-400 hover:bg-blue-400 transition-colors">JV Copilot</a>. 
          Building cool things with code. Based in the Bay Area.
        </p>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      {/* Projects Column */}
      <section class="lg:col-span-7">
        <h2 class="text-3xl font-black mb-8 flex items-center gap-3">
          <span class="bg-black text-white px-2">PROJECTS</span>
          <span class="text-base font-normal text-gray-500">SELECTED WORKS</span>
        </h2>
        
        <div class="grid grid-cols-1 gap-6">
          {projects.map((project, i) => (
            <a href={project.href} target="_blank" class="group block">
              <div class={`neo-card ${project.color} p-6 border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all duration-200`}>
                <div class="flex justify-between items-start mb-4">
                  <div class="bg-white border-2 border-black p-2 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
                    <project.icon size={24} />
                  </div>
                  <ArrowUpRight size={32} class="bg-white border-2 border-black p-1 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] group-hover:bg-black group-hover:text-white transition-colors" />
                </div>
                
                <h3 class="text-3xl font-black mb-2">{project.name}</h3>
                <p class="font-bold mb-4">{project.desc}</p>
                
                <div class="inline-block bg-white border-2 border-black px-3 py-1 text-sm font-bold shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
                  {project.tech}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* Writing Column */}
      <section class="lg:col-span-5">
        <h2 class="text-3xl font-black mb-8 flex items-center gap-3">
          <span class="bg-black text-white px-2">WRITING</span>
          <span class="text-base font-normal text-gray-500">THOUGHTS</span>
        </h2>

        <div class="space-y-4">
          {entries.map((entry) => (
            <a href={"/" + getSlugFromPath(entry.filePath ?? "")} class="block group">
              <div class="bg-white border-4 border-black p-4 shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:-translate-x-1 transition-all duration-200">
                <span class="text-xs font-bold bg-gray-200 px-2 py-1 border border-black mb-2 inline-block">
                  {format(parseISO(entry.data.date), "MMM dd, yyyy")}
                </span>
                <h3 class="text-lg font-bold leading-tight group-hover:underline decoration-2 underline-offset-2">
                  {entry.data.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>

    <footer class="mt-32 pt-12 border-t-4 border-black">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
        <div class="flex flex-wrap gap-4">
          <a href="https://github.com/aadishv" target="_blank" class="neo-button bg-white px-6 py-3 font-black border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-all">GITHUB</a>
          <a href="https://x.com/aadishvdotdev" target="_blank" class="neo-button bg-white px-6 py-3 font-black border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-all">TWITTER</a>
          <a href="https://www.linkedin.com/in/aadishv/" target="_blank" class="neo-button bg-white px-6 py-3 font-black border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-all">LINKEDIN</a>
        </div>
        <div class="text-right font-bold">
          <p class="text-2xl">AADISH.DEV</p>
          <p class="text-sm text-gray-600">© {new Date().getFullYear()}</p>
        </div>
      </div>
    </footer>

  </main>
</Layout>
