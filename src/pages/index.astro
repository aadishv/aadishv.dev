---
import Layout from "../layouts/Layout.astro";
import "@/styles/globals.css";
import { getCollection } from "astro:content";
import { parseISO, format } from "date-fns";
import { ArrowUpRight } from "lucide-react";

const getSlugFromPath = (path: string): string => {
  const parts = path.split("/");
  const filename = parts.pop() || "";
  return filename.replace(".md", "");
};

let allEntries = await getCollection("posts");
const entries = allEntries
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .filter((p) => p.data.hidden !== true);

const projects = [
  {
    name: "Dotlist",
    desc: "Productivity managers family",
    href: "https://dotlist.edwrdq.xyz/",
    year: "2024"
  },
  {
    name: "3151A",
    desc: "Custom AI & logic stack",
    href: "https://github.com/aadishv/AIWorlds",
    year: "2024"
  },
  {
    name: "Venice",
    desc: "Micropython runtime for VEX",
    href: "https://venice.fibn.cc",
    year: "2023"
  },
  {
    name: "OHS AC Utils",
    desc: "Chrome extension for students",
    href: "https://chromewebstore.google.com/detail/ohs-ac-utilities/mcnjeemajaoopeejjbfiieaepibmbjne",
    year: "2023"
  },
];
---

<Layout title="Aadish Verma" hideName={true} description="A freshman and avid programmer">
  <main class="min-h-screen p-4 md:p-12 max-w-[1400px] mx-auto flex flex-col justify-between">

    {/* Header Section */}
    <header class="mb-24 md:mb-32">
      <h1 class="text-[5rem] leading-[0.8] font-serif font-normal tracking-tighter text-foreground select-none">
        AADISH VERMA
      </h1>
      <div class="mt-8 flex flex-col md:flex-row md:items-start justify-between gap-8">
        <div class="max-w-xl">
          <p class="text-xl md:text-2xl font-serif leading-relaxed text-muted-foreground">
            Freshman at Stanford OHS. Founding engineer at <a href="https://www.jvcopilot.ai/" class="text-foreground border-b border-primary hover:bg-primary hover:text-primary-foreground transition-colors">JV Copilot</a>.
            Building software that feels <span class="italic">human</span>.
          </p>
        </div>
        <div class="font-mono text-sm md:text-right space-y-1 text-muted-foreground">
          <p>BAY AREA, CA</p>
          <p>{new Date().getFullYear()}</p>
        </div>
      </div>
    </header>

    {/* Projects Section */}
    <section class="mb-24">
      <div class="flex items-baseline justify-between mb-8 border-b border-border pb-2">
        <h2 class="font-mono text-sm uppercase tracking-widest text-muted-foreground">Selected Works</h2>
        <span class="font-mono text-sm text-muted-foreground">01 — 0{projects.length}</span>
      </div>

      <div class="flex flex-col">
        {projects.map((project, i) => (
          <a href={project.href} target="_blank" class="group border-b border-border py-2 flex flex-col md:flex-row md:items-baseline justify-between hover:bg-muted/20 transition-colors">
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-xs text-muted-foreground">0{i + 1}</span>
              <h3 class="text-2xl font-serif group-hover:translate-x-4 transition-transform duration-300">{project.name}</h3>
            </div>
            <div class="flex items-center gap-4">
                <span class="font-mono text-sm text-muted-foreground uppercase">{project.desc}</span>
              <span class="font-mono text-xs text-muted-foreground">{project.year}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* Writing Section */}
    <section class="mb-24">
      <div class="flex items-baseline justify-between mb-8 border-b border-border pb-2">
        <h2 class="font-mono text-sm uppercase tracking-widest text-muted-foreground">Writing</h2>
        <a href="/rss.xml" class="font-mono text-sm hover:text-primary transition-colors">RSS</a>
      </div>

      <div class="grid grid-cols-1 gap-y-4">
        {entries.map((entry) => (
          <a href={"/" + getSlugFromPath(entry.filePath ?? "")} class="group flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8 hover:opacity-60 transition-opacity">
            <time class="font-mono text-xs text-muted-foreground w-32 shrink-0">
              {format(parseISO(entry.data.date), "MMM dd, yyyy")}
            </time>
            <h3 class="text-lg md:text-xl font-serif border-b border-transparent group-hover:border-primary transition-colors leading-tight">
              {entry.data.title}
            </h3>
          </a>
        ))}
      </div>
    </section>

    {/* Footer */}
    <footer class="flex flex-col md:flex-row justify-between items-end gap-8 pt-12 border-t border-border">
      <div class="flex flex-col gap-2">
        <a href="mailto:aadish@ohs.stanford.edu" class="text-2xl font-serif hover:text-primary transition-colors">Email</a>
        <a href="https://github.com/aadishv" target="_blank" class="text-2xl font-serif hover:text-primary transition-colors">Github</a>
        <a href="https://x.com/aadishvdotdev" target="_blank" class="text-2xl font-serif hover:text-primary transition-colors">Twitter</a>
      </div>
      <div class="font-mono text-xs text-muted-foreground text-right">
        <p>DESIGNED & BUILT</p>
        <p>BY AADISH VERMA</p>
      </div>
    </footer>

  </main>
</Layout>
