---
import Layout from "../layouts/Layout.astro";
import "@/styles/globals.css";
import { getCollection } from "astro:content";
import { Badge } from "@/components/ui/badge";
import { parseISO, format } from "date-fns";
const getSlugFromPath = (path: string): string => {
  const parts = path.split("/");
  const filename = parts.pop() || "";
  return filename.replace(".md", "");
};
function formatDate(dateString: string) {
  try {
    return new Date(dateString).toLocaleDateString(undefined, {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  } catch {
    return dateString;
  }
}
let allEntries = await getCollection("posts");
const entries = allEntries
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .filter((p) => p.data.hidden !== true);

let value = 0;
const delay = () => {
  value += 30;
  return `
  animation-delay: ${value}ms;
  animation-name: appear !important;
  animation-timing-function: ease-in-out;
  animation-iteration-count: 1;
  animation-duration: 250ms;
  animation-fill-mode: forwards;
  opacity: 0;
`;
};
---

<Layout title="Aadish Verma" hideName={true}>
  <main class="container mx-auto py-10 lg:px-64">
    <div
      style="display: grid;  overflow: hidden; margin-top: -10%;"
    >
      <img
        style={`grid-column: 1; grid-row: 1; width: 100%; aspect-ratio: calc(3632/2734); ${delay()}`}
        id="image-of-the-pageload"
      />
      <script>
      const checkTheme = () => {
        const isDark = document.documentElement.classList.contains("dark");
        const number = Math.random() < 0.5 ? 1 : 2;
        const filepath = `/thumbnails/${isDark ? "dark" : "light"}-${number}.jpg`;
        const img = document.getElementById("image-of-the-pageload");
        img.src = filepath;
      };
      checkTheme();
      const observer = new MutationObserver(checkTheme);
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      })
      </script>
      <div
        style="background: linear-gradient(to bottom, hsl(var(--background)) 0%, hsl(var(--background)) 5%, transparent 40%, transparent 50%, hsl(var(--background)) 90%, hsl(var(--background)) 100%); z-index: 101; grid-column: 1; grid-row: 1;"
      >
      </div>
      <h1 style={`z-index: 102; grid-column: 1; grid-row: 1; margin-bottom: 15px; margin-left: 10px; margin-top: auto; font-size: 3rem; color: hsl(var(--foreground)); line-height: 3.0rem; ${delay()}`}>Aadish Verma</h1>
    </div>
    <span>
      <p style={delay()}>
        I’m Aadish, a freshman at Stanford Online High School who builds
        connected hardware-software systems: VEX robots, AI tools, and developer
        tooling that make practical problems easier to solve.
      </p>
      <p style={delay()}>
        Lately I’ve been focused on robotics and applied ML: custom CV and
        localization work, GPU-accelerated pipelines, and integrating AI into
        student-facing tools. I also ship small utilities and extensions (one
        has 100+ users), lead winning hackathon teams, and contribute fixes and
        tools to open-source projects used by other competitors and developers.
      </p>
      <p style={delay()}>
        I care about performance, reliability, and clear interfaces that make
        complex systems feel simple. If you want the longer story, my projects
        and write-ups are available, or just reach out!
      </p>
      <p style={delay()}>
        Check out my <a href="/background">programming background</a> for a few notable
        things I've done.
      </p>

      <p style={delay()}>
        Contact me!
        <br /><a href="mailto:aadish@ohs.stanford.edu">email</a>
        <br /><a href="https://github.com/aadishv" target="_blank">github</a>
      </p>

      <p style={delay()}>
        {"If I've built something else, you might find it"}
        <a href="/tools">here</a>
        {"or in my blog/projects ↓"}
      </p>
    </span>

    <!-- divider -->
    <hr class="my-4" />

    <!-- <EntryList entries={entries} client:load /> -->
    <ul id="entries-list" class="space-y-6">
      {
        entries.map((entry) => (
          <div style={delay()}>
            <a
              href={"/" + getSlugFromPath(entry.filePath ?? "")}
              class="text-xl decoration-none aadish-none"
            >
              <span
                class="underline hover:decoration-none"
                transition:name={entry.id}
              >
                {entry.data.title}
              </span>
              {entry.data.categories.map((c: string) => (
                <Badge variant="outline" className="ml-2 font-normal">
                  {c}
                </Badge>
              ))}
            </a>
            <time class="block" datetime={parseISO(entry.data.date).toString()}>
              {format(parseISO(entry.data.date), "LLLL d, yyyy")}
            </time>
            {entry.data.description && (
              <p class="text-sm text-muted-foreground line-clamp-3">
                {entry.data.description}
              </p>
            )}
          </div>
        ))
      }
    </ul>
  </main>
</Layout>
