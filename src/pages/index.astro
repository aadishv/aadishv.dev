---
import Layout from "../layouts/Layout.astro";
import "@/styles/globals.css";
import { getCollection } from "astro:content";
import { parseISO, format } from "date-fns";

const getSlugFromPath = (path: string): string => {
  const parts = path.split("/");
  const filename = parts.pop() || "";
  return filename.replace(".md", "");
};
function formatDate(dateString: string) {
  try {
    return new Date(dateString).toLocaleDateString(undefined, {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  } catch {
    return dateString;
  }
}
let allEntries = await getCollection("posts");
const entries = allEntries
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .filter((p) => p.data.hidden !== true);
---

<Layout
  title="Aadish Verma"
  hideName={true}
  description="A freshman and avid programmer"
>
    <div class="fixed lg:w-[10rem] w-5 h-screen bg-blue-500/20 left-0 top-0"></div>
    <div class="fixed lg:w-[16rem] w-[7.25rem] h-screen bg-green-500/50 left-0 top-0"></div>
  <main class="lg:mx-[10rem] mx-5 mt-24">

    <table class="w-full">
      <tr class="flex w-full mb-6">
        <th class="flex-0 w-24">&nbsp;</th>
        <th class="flex-1 !font-normal text-start max-w-[60rem]">
          <h1 class="font-medium tracking-tight text-aadish">Aadish Verma</h1>
          <p>
            I’m a programmer and freshman at Stanford Online High School,
            located in the Bay Area. I'm currently working as a founding
            developer at <a href="https://www.jvcopilot.ai/" target="_blank"
              >JV Copilot</a
            >.
          </p>

          <p class="flex flex-wrap gap-1.5">
            <a href="mailto:mail@aadishv.dev">email</a>
            •
            <a href="https://github.com/aadishv" target="_blank">github</a>
            •
            <a href="https://x.com/aadishvdotdev" target="_blank"
              >twitter (views my own)</a
            >
            •
            <a href="https://www.linkedin.com/in/aadishv/" target="_blank"
              >linkedin</a
            >
            •
            <span>discord @aadishv</span>
          </p>
          <p>
              I sometimes have shower thoughts that aren't interesting enough to end up in a blog post; you'll find such ramblings <a href="/notes">here</a>.
          </p>
        </th>
      </tr>
      {
        entries.map((entry) => (
          <tr class="flex mb-1">
            <td class="text-lg !font-normal w-24 border-2">
              <time
                datetime={parseISO(entry.data.date).toString()}
                class="text-muted-foreground flex"
              >
                  <span class="ml-auto mr-2">{format(parseISO(entry.data.date), "MM.dd.yy")}</span>
                <span class="text-aadish">/</span>
              </time>
            </td>
            <td class="text-lg !font-normal flex-1 ">
              <a
                href={"/" + getSlugFromPath(entry.filePath ?? "")}
                class="ml-2 aadish-none hover:text-aadish"
                transition:name={entry.id}
              >
                {entry.data.title}
              </a>
            </td>
          </tr>
        ))
      }
    </table>
  </main>
</Layout>
